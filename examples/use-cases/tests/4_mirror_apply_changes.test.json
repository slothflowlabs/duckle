{
  "pipeline": "../pipelines/4_mirror_apply_changes.json",
  "cases": [
    {
      "name": "only what changed is sent, each with the diff's tag",
      "given": {
        "tuesday": "fixtures/tuesday.csv",
        "monday": "fixtures/monday.csv"
      },
      "expect": {
        "node": "diff",
        "unordered": true,
        "rows": [
          {
            "customer_id": 2,
            "name": "Grace",
            "email": "grace.hopper@example.com",
            "plan": "team",
            "change_type": "updated"
          },
          {
            "customer_id": 3,
            "name": null,
            "email": null,
            "plan": null,
            "change_type": "deleted"
          },
          {
            "customer_id": 4,
            "name": "Edsger",
            "email": "edsger@example.com",
            "plan": "team",
            "change_type": "inserted"
          }
        ]
      }
    },
    {
      "name": "an unchanged customer is not sent at all",
      "given": {
        "tuesday": "fixtures/tuesday.csv",
        "monday": "fixtures/monday.csv"
      },
      "expect": {
        "node": "diff",
        "sql": "SELECT count(*) = 0 FROM {rows} WHERE customer_id = 1"
      }
    }
  ]
}
