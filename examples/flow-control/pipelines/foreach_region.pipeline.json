{
  "formatVersion": 1,
  "name": "For-each region export (wait / distinct / for-each)",
  "nodes": [
    {
      "id": "src",
      "type": "source",
      "position": { "x": 0, "y": 0 },
      "data": {
        "label": "Orders",
        "componentId": "src.csv",
        "properties": { "path": "${workspace}/data/orders.csv", "hasHeader": true }
      }
    },
    {
      "id": "wait",
      "type": "transform",
      "position": { "x": 240, "y": 0 },
      "data": {
        "label": "Settle",
        "componentId": "ctl.wait",
        "properties": { "duration": 250, "unit": "milliseconds" }
      }
    },
    {
      "id": "regions",
      "type": "transform",
      "position": { "x": 480, "y": 0 },
      "data": {
        "label": "Regions seen",
        "componentId": "xf.distinct",
        "properties": { "columns": ["region"] }
      }
    },
    {
      "id": "each",
      "type": "transform",
      "position": { "x": 720, "y": 0 },
      "data": {
        "label": "Export each region",
        "componentId": "ctl.foreach",
        "properties": { "pipelineRef": "_region_export.pipeline.json", "itemKey": "region", "concurrency": 1 }
      }
    }
  ],
  "edges": [
    { "id": "e1", "source": "src", "target": "wait", "sourceHandle": "main", "targetHandle": "main", "data": { "connectionType": "main" } },
    { "id": "e2", "source": "wait", "target": "regions", "sourceHandle": "main", "targetHandle": "main", "data": { "connectionType": "main" } },
    { "id": "e3", "source": "regions", "target": "each", "sourceHandle": "main", "targetHandle": "main", "data": { "connectionType": "main" } }
  ]
}
