{
  "formatVersion": 1,
  "name": "Try with a fallback (try / filter / sink)",
  "nodes": [
    {
      "id": "src",
      "type": "source",
      "position": { "x": 0, "y": 0 },
      "data": {
        "label": "Orders",
        "componentId": "src.csv",
        "properties": { "path": "${workspace}/data/orders.csv", "hasHeader": true }
      }
    },
    {
      "id": "try",
      "type": "transform",
      "position": { "x": 240, "y": 0 },
      "data": {
        "label": "Attempt",
        "componentId": "ctl.try",
        "properties": { "fallbackPipelineRef": "_notify_error.pipeline.json" }
      }
    },
    {
      "id": "flt",
      "type": "transform",
      "position": { "x": 480, "y": 0 },
      "data": {
        "label": "Positive amounts",
        "componentId": "xf.filter",
        "properties": { "predicate": "amount > 0" }
      }
    },
    {
      "id": "snk",
      "type": "sink",
      "position": { "x": 720, "y": 0 },
      "data": {
        "label": "Clean orders",
        "componentId": "snk.csv",
        "properties": { "path": "${workspace}/output/clean_orders.csv", "writeHeader": true }
      }
    }
  ],
  "edges": [
    { "id": "e1", "source": "src", "target": "try", "sourceHandle": "main", "targetHandle": "main", "data": { "connectionType": "main" } },
    { "id": "e2", "source": "try", "target": "flt", "sourceHandle": "main", "targetHandle": "main", "data": { "connectionType": "main" } },
    { "id": "e3", "source": "flt", "target": "snk", "sourceHandle": "main", "targetHandle": "main", "data": { "connectionType": "main" } }
  ]
}
