# Maintainer: Sourav Roy <souravroy7864@gmail.com>
#
# The headless runner: no GUI, no desktop libraries, statically linked against
# musl. This is the package a server wants, and the one most likely to install
# cleanly anywhere, which is why it is separated from the desktop app rather
# than shipped as one package with optional dependencies.

pkgname=duckle-runner-bin
pkgver=0.8.0
pkgrel=1
pkgdesc="Headless runner for Duckle data pipelines (static binary)"
arch=('x86_64')
# Measured, not assumed: installed to /usr/bin there is no bin/duckdb beside
# the runner, so DuckDB resolution falls through to PATH. Without this the
# package installs cleanly and then cannot run a single pipeline. Arch's
# duckdb is 1.5.5, which is what Duckle pins, and a real pipeline ran on it.
depends=('duckdb')
url="https://github.com/slothflowlabs/duckle"
license=('MIT OR Apache-2.0')
provides=('duckle-runner')
conflicts=('duckle-runner')
options=('!strip')

# Fetched over https from the tagged release.
# Maintained by packaging/arch/bump.py, which the release workflow runs when a
# release is published. The binary's value is the one the release itself
# publishes in SHA256SUMS.txt, not one computed separately here.
source=("duckle-runner-${pkgver}::${url}/releases/download/v${pkgver}/duckle-runner-linux-x64"
        "LICENSE-MIT-${pkgver}::https://raw.githubusercontent.com/slothflowlabs/duckle/v${pkgver}/LICENSE-MIT"
        "LICENSE-APACHE-${pkgver}::https://raw.githubusercontent.com/slothflowlabs/duckle/v${pkgver}/LICENSE-APACHE")
sha256sums=('9fb005ba092992fa6115ac0f64c94d88d5e9e716c9a5957735467cc6becbf632'
            '95935915cc360fbaf736ecbe22229671c404fc0bc53dab63663a58a9352fcea9'
            '1e7e1bc923e0f439d5aefb15b19be5082079f2929f86da51ae1339d1db5bce2b')

package() {
  install -Dm755 "${srcdir}/duckle-runner-${pkgver}" "${pkgdir}/usr/bin/duckle-runner"
  install -Dm644 "${srcdir}/LICENSE-MIT-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-MIT"
  install -Dm644 "${srcdir}/LICENSE-APACHE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-APACHE"
}
